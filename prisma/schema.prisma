datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String    @unique
  password        String
  role            Role      @default(STUDENT)
  isValid         Boolean   @default(false)
  activationToken String?
  profileImage    String?
  createdAt       DateTime  @default(now())
  
  // If it's a student, we link his informations
  studentProfile  Student?
}

enum Role {
  ADMIN
  LIBRARIAN
  STUDENT
}

// Informations related to students
model Student {
  id                 Int           @id @default(autoincrement())
  registrationNumber String        @unique
  birthDate          DateTime
  classroom          String
  studyStream        String?
  qrCodeId           String        @unique
  studentPhoto       String?
  
  // Link with the user account
  userId             Int           @unique
  user               User          @relation(fields: [userId], references: [id])
  
  // Link with parent
  parentEmail        String        
  
  loans              Loan[]
  reservations       Reservation[]
}

// Tables of books
model Book {
  id              Int           @id @default(autoincrement())
  title           String
  author          String
  isbn            String        @unique
  availableCopies Int           @default(1)
  category        String
  coverImage      String?
  location        String?
  
  loans           Loan[]
  reservations    Reservation[]
}

// Reservations table (Reservations are available in 24h)
model Reservation {
  id              Int      @id @default(autoincrement())
  reservationDate DateTime @default(now())
  expiresAt       DateTime 
  status          String   @default("PENDING") // PENDING, VALIDATED, EXPIRED
  
  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id])
  
  bookId          Int
  book            Book     @relation(fields: [bookId], references: [id])
}

// Loans table (Default : Actifs)
model Loan {
  id              Int       @id @default(autoincrement())
  loanDate        DateTime  @default(now())
  dueDate         DateTime
  returnDate      DateTime?
  status          String    @default("ACTIVE") // ACTIVE, RETURNED, LATE
  
  studentId       Int
  student         Student   @relation(fields: [studentId], references: [id])
  
  bookId          Int
  book            Book      @relation(fields: [bookId], references: [id])
}
